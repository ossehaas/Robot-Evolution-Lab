#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    doc = """Generated from Composed Stage of root layer <temp>\\simple_leg.usdc


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\usdex\\simple_leg.usdc


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\temp\\simple_leg.usd


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\simple_leg\\payloads\\base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Scope "Materials"
{
    def Material "blue"
    {
        color3f inputs:diffuseColor = (0, 0, 1)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/blue/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/blue/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/blue.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/blue.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/blue.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/blue.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "red"
    {
        color3f inputs:diffuseColor = (1, 0, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/red/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/red/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/red.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/red.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/red.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/red.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

    def Material "green"
    {
        color3f inputs:diffuseColor = (0, 1, 0)
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0.5
        token inputs:wrapMode = "repeat"
        token outputs:displacement (
            displayGroup = "Outputs"
        )
        prepend token outputs:displacement.connect = </Materials/green/PreviewSurface.outputs:displacement>
        token outputs:surface (
            displayGroup = "Outputs"
        )
        prepend token outputs:surface.connect = </Materials/green/PreviewSurface.outputs:surface>
        token outputs:volume (
            displayGroup = "Outputs"
        )

        def Shader "PreviewSurface" (
            apiSchemas = ["NodeDefAPI"]
        )
        {
            token info:id = "UsdPreviewSurface"
            prepend color3f inputs:diffuseColor.connect = </Materials/green.inputs:diffuseColor>
            prepend float inputs:metallic.connect = </Materials/green.inputs:metallic>
            prepend float inputs:opacity.connect = </Materials/green.inputs:opacity>
            prepend float inputs:roughness.connect = </Materials/green.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }
}

