#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "simple_leg"
    doc = """Generated from Composed Stage of root layer <temp>\\simple_leg.usdc


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\usdex\\simple_leg.usdc


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\temp\\simple_leg.usd


Generated from Composed Stage of root layer prototypes\\simple_leg\\sim\\simple_leg\\payloads\\base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "simple_leg"
{
    over "Geometry"
    {
        over "base_link" (
            delete apiSchemas = ["NewtonArticulationRootAPI"]
            prepend apiSchemas = ["PhysxArticulationAPI"]
        )
        {
            bool physxArticulation:enabledSelfCollisions = 0

            over "thigh_link"
            {
                over "calf_link"
                {
                    over "cylinder"
                    {
                    }

                    over "cylinder_1"
                    {
                    }
                }

                over "cylinder"
                {
                }

                over "cylinder_1"
                {
                }
            }

            over "box"
            {
            }

            over "box_1"
            {
            }
        }
    }

    over "Physics"
    {
        over "hip_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.9578
        }

        over "knee_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
            float physxJoint:maxJointVelocity = 572.9578
        }

        over "root_joint"
        {
        }
    }

    over "Materials"
    {
        over "blue"
        {
        }

        over "red"
        {
        }

        over "green"
        {
        }
    }
}

