#usda 1.0
(
    defaultPrim = "Robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Robot" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    customData = {
        dictionary evolution = {
            string genome = "puppy"
        }
    }
)
{
    def Scope "Looks"
    {
        def Material "physics_pla" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.35
            float physics:restitution = 0.1
            float physics:staticFriction = 0.45
        }

        def Material "physics_tpu" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.85
            float physics:restitution = 0
            float physics:staticFriction = 1
            custom float physxMaterial:compliantContactDamping = 100
            custom float physxMaterial:compliantContactStiffness = 10000
        }

        def Material "cap_0"
        {
            token outputs:surface.connect = </Robot/Looks/cap_0/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.89126205, 0.7742273, 0.59243804)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "spot_1"
        {
            token outputs:surface.connect = </Robot/Looks/spot_1/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.47044024, 0.16364068, 0.038472746)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "L_2"
        {
            token outputs:surface.connect = </Robot/Looks/L_2/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.10114516, 0.03994717, 0.018912984)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "collar_3"
        {
            token outputs:surface.connect = </Robot/Looks/collar_3/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.69408053, 0.038472746, 0.038472746)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "tag_4"
        {
            token outputs:surface.connect = </Robot/Looks/tag_4/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.89126205, 0.5479935, 0.025371278)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "nose_5"
        {
            token outputs:surface.connect = </Robot/Looks/nose_5/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.009021492, 0.0065849572, 0.0065849572)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "eye_6"
        {
            token outputs:surface.connect = </Robot/Looks/eye_6/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.0036972396, 0.0036972396, 0.0036972396)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "shine_7"
        {
            token outputs:surface.connect = </Robot/Looks/shine_7/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (1, 1, 1)
                float inputs:metallic = 0
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }
    }

    def Xform "chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        point3f physics:centerOfMass = (-0.0006464842, -0.0000618291, 0.0023493362)
        float3 physics:diagonalInertia = (0.0011821479, 0.002978706, 0.00303456)
        float physics:mass = 0.8428489
        quatf physics:principalAxes = (0.015739443, 0.9997804, -0.0003965107, 0.013828986)
        quatf xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Scope "visuals"
        {
            def Mesh "cap_0" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
